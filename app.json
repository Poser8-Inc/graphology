{
  "expo": {
    "name": "Graphology",
    "slug": "graphology",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.poser8.graphology",
      "supportsTablet": false
    },
    "android": {
      "package": "com.poser8.graphology",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0908"
      }
    },
    "plugins": [
      "expo-router",
      "expo-camera",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Graphology to access your photos to analyze handwriting samples."
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0908"
    },
    "scheme": "graphology"
  }
}